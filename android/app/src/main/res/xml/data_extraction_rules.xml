<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing of this app goes to cloud backup or to device-to-device transfer.
     The buffer holds location traces, and a restored Firebase session would give two phones
     the same anonymous ID (it must be one ID per installation). Found in Phase 6. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
